// SecondHelping — Prisma schema (core + AI modules)
// Conventions: money in cents (Int), rates as 0..1 (Float), ids as cuid strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ════════════════════════════════════════════════════════════════
// ENUMS — CORE
// ════════════════════════════════════════════════════════════════

enum Role {
  STUDENT
  OWNER
  MODERATOR
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum DiningHallType {
  CANTEEN
  RESTAURANT
  CAFE
  OTHER
}

enum MemberRelation {
  OWNER
  SUPERVISOR
  FOLLOWER
}

enum ListingStatus {
  DRAFT
  ACTIVE
  SOLD_OUT
  EXPIRED
  CANCELLED
}

enum OrderStatus {
  PENDING_PAYMENT
  CONFIRMED
  READY_FOR_PICKUP
  PICKED_UP
  CANCELLED
  EXPIRED
  NO_SHOW
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum MediaKind {
  IMAGE
  AUDIO
}

enum ReportState {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportSubjectType {
  USER
  DINING_HALL
  LISTING
  ORDER
}

// ════════════════════════════════════════════════════════════════
// ENUMS — AI
// ════════════════════════════════════════════════════════════════

enum ModelModule {
  SURPLUS_ENGINE
  PREP_COPILOT
  LISTING_COPILOT
  DYNAMIC_PRICING
  RESCUE_ROUTER
  IMPACT_ESTIMATOR
}

enum MealPeriod {
  BREAKFAST
  LUNCH
  SNACK
  DINNER
}

enum CampusEventKind {
  EVENT
  EXAM
  HOLIDAY
  CLASS_BLOCK
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum DraftSource {
  PHOTO
  VOICE
}

enum DraftStatus {
  PENDING_REVIEW
  APPROVED
  DISCARDED
}

enum ListingEventType {
  VIEW
  SAVE
  RESERVE
}

enum RescueDestinationType {
  PANTRY
  SHELTER
  STAFF_MEAL
  KITCHEN
  COMPOST
}

enum DispatchStatus {
  RECOMMENDED
  ACCEPTED
  COMPLETED
  REJECTED
  CANCELLED
}

// ════════════════════════════════════════════════════════════════
// CORE — USERS
// ════════════════════════════════════════════════════════════════

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  passwordHash  String
  role          Role
  accountStatus AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Disjoint specialization (exactly one, matching `role`)
  studentProfile   StudentProfile?
  ownerProfile     OwnerProfile?
  moderatorProfile ModeratorProfile?

  sessions         AuthSession[]
  memberships      DiningHallMember[]
  allergies        UserAllergy[]
  listingsCreated  Listing[]
  mediaUploaded    MediaAsset[]
  orders           Order[]
  reportsFiled     Report[]           @relation("ReportReporter")
  reportsHandled   Report[]           @relation("ReportHandler")

  // AI
  prepDecisions    PrepRecommendation[]
  simulations      SimulationScenario[]
  listingDrafts    ListingDraft[]
  listingEvents    ListingEvent[]

  @@index([role])
}

// Training data for the models lives here
model StudentProfile {
  userId             String  @id
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  gender             String?
  age                Int?
  monthlyIncomeCents Int?
  balanceCents       Int     @default(0)
}

model OwnerProfile {
  userId             String  @id
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  numberOfEmployees  Int?
  monthlyIncomeCents Int?
}

model ModeratorProfile {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions String[]
}

model AuthSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ════════════════════════════════════════════════════════════════
// CORE — DINING HALLS & MENU
// ════════════════════════════════════════════════════════════════

// Merges ER "Restaurant" + "Address" (1:1)
model DiningHall {
  id           String         @id @default(cuid())
  name         String         @unique
  type         DiningHallType @default(CANTEEN)
  canteen      String?
  storeNumber  String?
  postalCode   String?
  latitude     Float?
  longitude    Float?
  openingHours Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  members    DiningHallMember[]
  foodItems  FoodItem[]
  listings   Listing[]
  orders     Order[]
  media      MediaAsset[]

  // AI
  dailyProductions    DailyProduction[]
  weatherObservations WeatherObservation[]
  surplusForecasts    SurplusForecast[]
  simulations         SimulationScenario[]
  listingDrafts       ListingDraft[]
  pricingPolicies     PricingPolicy[]
  impactRecords       ImpactRecord[]
}

// Owner / supervisor / follower of a dining hall (N:N with a role)
model DiningHallMember {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  diningHallId String
  diningHall   DiningHall     @relation(fields: [diningHallId], references: [id], onDelete: Cascade)
  relation     MemberRelation
  createdAt    DateTime       @default(now())

  @@unique([userId, diningHallId, relation])
  @@index([diningHallId, relation])
}

model Ingredient {
  id          String  @id @default(cuid())
  name        String  @unique
  isAllergen  Boolean @default(false)

  users     UserAllergy[]
  foodItems FoodItemIngredient[]
  listings  ListingIngredient[]
}

model UserAllergy {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([userId, ingredientId])
}

// Regular menu item (catalog)
model FoodItem {
  id             String   @id @default(cuid())
  diningHallId   String
  diningHall     DiningHall @relation(fields: [diningHallId], references: [id], onDelete: Cascade)
  name           String
  basePriceCents Int
  category       String?
  unitWeightGrams Int?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  ingredients FoodItemIngredient[]
  listings    Listing[]
  media       MediaAsset[]

  // AI
  dailyProductions DailyProduction[]
  surplusForecasts SurplusForecast[]

  @@index([diningHallId])
}

model FoodItemIngredient {
  foodItemId   String
  foodItem     FoodItem   @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([foodItemId, ingredientId])
}

// ════════════════════════════════════════════════════════════════
// CORE — LISTINGS (surplus offers)
// ════════════════════════════════════════════════════════════════

model Listing {
  id                 String        @id @default(cuid())
  diningHallId       String
  diningHall         DiningHall    @relation(fields: [diningHallId], references: [id])
  createdById        String
  createdBy          User          @relation(fields: [createdById], references: [id])
  foodItemId         String?
  foodItem           FoodItem?     @relation(fields: [foodItemId], references: [id], onDelete: SetNull)

  title              String
  description        String?
  category           String?
  unitWeightGrams    Int?
  originalPriceCents Int
  priceCents         Int
  discountRate       Float         // 0..1
  quantityTotal      Int
  quantityRemaining  Int
  pickupWindowStart  DateTime
  pickupWindowEnd    DateTime
  status             ListingStatus @default(ACTIVE)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  ingredients ListingIngredient[]
  media       MediaAsset[]
  orderItems  OrderItem[]

  // AI
  draft            ListingDraft?
  priceChanges     PriceChange[]
  events           ListingEvent[]
  rescueDispatches RescueDispatch[]

  @@index([diningHallId, status])
  @@index([status, pickupWindowEnd])
}

model ListingIngredient {
  listingId    String
  listing      Listing    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@id([listingId, ingredientId])
}

// Replaces "Photo"; also supports audio (voice listing copilot)
model MediaAsset {
  id           String     @id @default(cuid())
  kind         MediaKind
  url          String
  uploadedById String
  uploadedBy   User       @relation(fields: [uploadedById], references: [id])
  diningHallId String?
  diningHall   DiningHall? @relation(fields: [diningHallId], references: [id], onDelete: SetNull)
  foodItemId   String?
  foodItem     FoodItem?  @relation(fields: [foodItemId], references: [id], onDelete: SetNull)
  listingId    String?
  listing      Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)
  createdAt    DateTime   @default(now())

  listingDrafts ListingDraft[]

  @@index([diningHallId])
  @@index([foodItemId])
  @@index([listingId])
}

// ════════════════════════════════════════════════════════════════
// CORE — ORDERS & PAYMENTS
// ════════════════════════════════════════════════════════════════

model Order {
  id                String      @id @default(cuid())
  studentId         String
  student           User        @relation(fields: [studentId], references: [id])
  diningHallId      String
  diningHall        DiningHall  @relation(fields: [diningHallId], references: [id])
  platformFeeCents  Int         @default(0)
  serviceFeeCents   Int         @default(0)
  totalCents        Int
  pickupCode        String      @unique
  status            OrderStatus @default(PENDING_PAYMENT)
  pickupWindowStart DateTime
  pickupWindowEnd   DateTime
  pickedUpAt        DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items    OrderItem[]
  payments Payment[]
  reports  Report[]

  @@index([studentId, createdAt])
  @@index([diningHallId, status])
}

model OrderItem {
  id                 String  @id @default(cuid())
  orderId            String
  order              Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId          String
  listing            Listing @relation(fields: [listingId], references: [id])
  quantity           Int
  originalPriceCents Int
  discountRate       Float
  finalPriceCents    Int

  impactRecords ImpactRecord[]

  @@index([orderId])
  @@index([listingId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id])
  method            PaymentMethod
  amountCents       Int
  status            PaymentStatus @default(PENDING)
  externalGatewayId String?       @unique
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([orderId])
}

// ════════════════════════════════════════════════════════════════
// CORE — MODERATION
// ════════════════════════════════════════════════════════════════

// "Report Subject" is polymorphic: subjectType + subjectId
model Report {
  id          String            @id @default(cuid())
  reporterId  String
  reporter    User              @relation("ReportReporter", fields: [reporterId], references: [id])
  handledById String?
  handledBy   User?             @relation("ReportHandler", fields: [handledById], references: [id])
  orderId     String?
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subjectType ReportSubjectType
  subjectId   String
  state       ReportState       @default(OPEN)
  content     String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([state])
  @@index([subjectType, subjectId])
}

// ════════════════════════════════════════════════════════════════
// AI — MODEL REGISTRY
// ════════════════════════════════════════════════════════════════

model ModelVersion {
  id        String      @id @default(cuid())
  module    ModelModule
  name      String
  version   String
  metrics   Json?
  trainedAt DateTime?
  isActive  Boolean     @default(false)
  createdAt DateTime    @default(now())

  surplusForecasts SurplusForecast[]
  simulations      SimulationScenario[]
  listingDrafts    ListingDraft[]
  priceChanges     PriceChange[]
  rescueDispatches RescueDispatch[]

  @@unique([module, name, version])
}

// ════════════════════════════════════════════════════════════════
// AI — PREDICTIVE SURPLUS ENGINE + PREP COPILOT / DIGITAL TWIN
// ════════════════════════════════════════════════════════════════

model CampusEvent {
  id                 String          @id @default(cuid())
  name               String
  kind               CampusEventKind
  location           String?
  expectedAttendance Int?
  startsAt           DateTime
  endsAt             DateTime

  forecasts SurplusForecast[] // implicit N:N ("Influences")

  @@index([startsAt, endsAt])
}

model WeatherObservation {
  id            String     @id @default(cuid())
  diningHallId  String
  diningHall    DiningHall @relation(fields: [diningHallId], references: [id], onDelete: Cascade)
  observedAt    DateTime
  temperatureC  Float?
  precipitation Float?
  condition     String?

  @@unique([diningHallId, observedAt])
}

// Historical sales / leftovers / waste (training data)
model DailyProduction {
  id           String     @id @default(cuid())
  diningHallId String
  diningHall   DiningHall @relation(fields: [diningHallId], references: [id], onDelete: Cascade)
  foodItemId   String
  foodItem     FoodItem   @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  date         DateTime   @db.Date
  mealPeriod   MealPeriod
  plannedQty   Int?
  preparedQty  Int
  soldQty      Int
  leftoverQty  Int
  wasteKg      Float?

  @@unique([diningHallId, foodItemId, date, mealPeriod])
  @@index([date])
}

model SurplusForecast {
  id              String       @id @default(cuid())
  diningHallId    String
  diningHall      DiningHall   @relation(fields: [diningHallId], references: [id], onDelete: Cascade)
  foodItemId      String
  foodItem        FoodItem     @relation(fields: [foodItemId], references: [id], onDelete: Cascade)
  modelVersionId  String
  modelVersion    ModelVersion @relation(fields: [modelVersionId], references: [id])
  targetDate      DateTime     @db.Date
  mealPeriod      MealPeriod
  expectedSurplus Float
  ciLow           Float
  ciHigh          Float
  features        Json?
  createdAt       DateTime     @default(now())

  events          CampusEvent[]
  recommendations PrepRecommendation[]

  @@index([diningHallId, targetDate])
}

model PrepRecommendation {
  id                String               @id @default(cuid())
  forecastId        String
  forecast          SurplusForecast      @relation(fields: [forecastId], references: [id], onDelete: Cascade)
  decidedById       String?
  decidedBy         User?                @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  recommendedQty    Int
  currentPlannedQty Int
  status            RecommendationStatus @default(PENDING)
  decidedAt         DateTime?
  createdAt         DateTime             @default(now())

  @@index([forecastId])
}

model SimulationScenario {
  id             String       @id @default(cuid())
  diningHallId   String
  diningHall     DiningHall   @relation(fields: [diningHallId], references: [id], onDelete: Cascade)
  createdById    String?
  createdBy      User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  modelVersionId String
  modelVersion   ModelVersion @relation(fields: [modelVersionId], references: [id])
  params         Json
  results        Json?
  createdAt      DateTime     @default(now())

  @@index([diningHallId])
}

// ════════════════════════════════════════════════════════════════
// AI — MULTIMODAL LISTING COPILOT
// ════════════════════════════════════════════════════════════════

model ListingDraft {
  id             String       @id @default(cuid())
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  diningHallId   String
  diningHall     DiningHall   @relation(fields: [diningHallId], references: [id], onDelete: Cascade)
  mediaAssetId   String
  mediaAsset     MediaAsset   @relation(fields: [mediaAssetId], references: [id])
  modelVersionId String
  modelVersion   ModelVersion @relation(fields: [modelVersionId], references: [id])
  listingId      String?      @unique // set when the draft becomes a Listing
  listing        Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  sourceType     DraftSource
  transcript     String?
  draft          Json
  confidence     Float?
  status         DraftStatus  @default(PENDING_REVIEW)
  createdAt      DateTime     @default(now())

  @@index([createdById])
  @@index([diningHallId, status])
}

// ════════════════════════════════════════════════════════════════
// AI — DYNAMIC PRICING AGENT
// ════════════════════════════════════════════════════════════════

model PricingPolicy {
  id               String     @id @default(cuid())
  diningHallId     String
  diningHall       DiningHall @relation(fields: [diningHallId], references: [id], onDelete: Cascade)
  minDiscountRate  Float
  maxDiscountRate  Float
  maxStepRate      Float?     // max change per adjustment (fairness cap)
  fairnessRules    Json?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())

  priceChanges PriceChange[]

  @@index([diningHallId, isActive])
}

model PriceChange {
  id              String        @id @default(cuid())
  listingId       String
  listing         Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  policyId        String
  policy          PricingPolicy @relation(fields: [policyId], references: [id])
  modelVersionId  String
  modelVersion    ModelVersion  @relation(fields: [modelVersionId], references: [id])
  oldDiscountRate Float
  newDiscountRate Float
  reason          String?
  signals         Json?
  createdAt       DateTime      @default(now())

  @@index([listingId, createdAt])
}

// Demand signals for pricing
model ListingEvent {
  id        String           @id @default(cuid())
  listingId String
  listing   Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  type      ListingEventType
  createdAt DateTime         @default(now())

  @@index([listingId, type, createdAt])
}

// ════════════════════════════════════════════════════════════════
// AI — RESCUE ROUTER
// ════════════════════════════════════════════════════════════════

model RescueDestination {
  id                 String                @id @default(cuid())
  type               RescueDestinationType
  name               String
  address            String?
  latitude           Float?
  longitude          Float?
  capacityKg         Float?
  acceptedCategories Json?
  openingHours       Json?
  isActive           Boolean               @default(true)

  dispatches RescueDispatch[]
}

model RescueDispatch {
  id             String            @id @default(cuid())
  listingId      String
  listing        Listing           @relation(fields: [listingId], references: [id])
  destinationId  String
  destination    RescueDestination @relation(fields: [destinationId], references: [id])
  modelVersionId String?
  modelVersion   ModelVersion?     @relation(fields: [modelVersionId], references: [id], onDelete: SetNull)
  quantity       Int
  weightKg       Float
  status         DispatchStatus    @default(RECOMMENDED)
  recommendedAt  DateTime          @default(now())
  completedAt    DateTime?

  impactRecords ImpactRecord[]

  @@index([listingId])
  @@index([destinationId, status])
}

// ════════════════════════════════════════════════════════════════
// AI — IMPACT ESTIMATOR
// ════════════════════════════════════════════════════════════════

model EmissionFactor {
  id          String   @id @default(cuid())
  category    String
  co2PerKg    Float
  waterPerKg  Float
  landPerKg   Float
  source      String?
  validFrom   DateTime @db.Date

  impactRecords ImpactRecord[]

  @@unique([category, validFrom])
}

// One of orderItemId / rescueDispatchId must be set.
// Enforce with a CHECK constraint in a raw SQL migration:
//   ALTER TABLE "ImpactRecord" ADD CONSTRAINT impact_one_source
//   CHECK (("orderItemId" IS NOT NULL) <> ("rescueDispatchId" IS NOT NULL));
model ImpactRecord {
  id                  String          @id @default(cuid())
  diningHallId        String
  diningHall          DiningHall      @relation(fields: [diningHallId], references: [id])
  orderItemId         String?
  orderItem           OrderItem?      @relation(fields: [orderItemId], references: [id], onDelete: SetNull)
  rescueDispatchId    String?
  rescueDispatch      RescueDispatch? @relation(fields: [rescueDispatchId], references: [id], onDelete: SetNull)
  emissionFactorId    String
  emissionFactor      EmissionFactor  @relation(fields: [emissionFactorId], references: [id])
  mealsRescued        Int
  kgDiverted          Float
  co2AvoidedKg        Float
  waterSavedL         Float
  landSavedM2         Float
  studentSavingsCents Int             @default(0)
  createdAt           DateTime        @default(now())

  @@index([diningHallId, createdAt])
}
