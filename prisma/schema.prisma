// SecondHelping marketplace data model.
// PostgreSQL connection is configured in prisma7.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DiningHall {
  id          String    @id @default(cuid())
  name        String    @unique
  address     String?
  latitude    Float?
  longitude   Float?
  supervisors User[]    @relation("Supervisors")
  followers   User[]    @relation("FollowedDiningHalls")
  listings    Listing[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Listing {
  id                 String        @id @default(cuid())
  title              String
  description        String?
  originalPriceCents Int
  priceCents         Int
  discountRate       Int           // Percentage, from 0 to 100
  quantityTotal      Int
  quantityRemaining  Int
  allergens          String[]      @default([])
  pickupWindowStart  DateTime
  pickupWindowEnd    DateTime
  status             ListingStatus @default(ACTIVE)

  diningHallId String
  diningHall   DiningHall @relation(fields: [diningHallId], references: [id])

  createdById String?
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])

  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([diningHallId, status, pickupWindowStart])
}

model Order {
  id                 String      @id @default(cuid())
  listingId          String
  listing            Listing     @relation(fields: [listingId], references: [id])
  studentId          String
  student            User        @relation(fields: [studentId], references: [id])
  quantity           Int         @default(1)
  originalPriceCents Int
  discountRate       Int
  finalPriceCents    Int
  platformFeeCents   Int         @default(0)
  serviceFeeCents    Int         @default(0)
  pickupCode         String      @unique @default(cuid())
  status             OrderStatus @default(RESERVED)
  pickupWindowStart  DateTime
  pickupWindowEnd    DateTime
  pickedUpAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([studentId, createdAt])
  @@index([listingId, status])
  @@index([pickupWindowEnd, status])
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  password        String
  name            String?
  role            Role          @default(STUDENT)
  diningHallId    String?
  diningHall      DiningHall?   @relation("Supervisors", fields: [diningHallId], references: [id])
  followedHalls   DiningHall[]  @relation("FollowedDiningHalls")
  createdListings Listing[]     @relation("CreatedBy")
  orders          Order[]
  sessions        AuthSession[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum Role {
  STUDENT
  SUPERVISOR
}

enum ListingStatus {
  ACTIVE
  SOLD_OUT
  EXPIRED
  WITHDRAWN
}

enum OrderStatus {
  RESERVED
  PICKED_UP
  CANCELLED
  EXPIRED
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
