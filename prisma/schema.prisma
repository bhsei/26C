// SecondHelping marketplace data model.
// PostgreSQL connection is configured in prisma7.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ════════════════════════════════════════════════════════════════
// DataModels 
// ════════════════════════════════════════════════════════════════

model DiningHall {
  id            String         @id @default(cuid())
  name          String         @unique
  address       String?
  latitude      Float?
  longitude     Float?
  supervisors   User[]         @relation("Supervisors")
  listings      Listing[]
  listingDrafts ListingDraft[]
  impactRecords ImpactRecord[]
  pricingPolicies PricingPolicy[]
  dailyProductions DailyProduction[]
  weatherObservations WeatherObservation[]
  campaignEvents CampaignEvent[]
  surplusForecasts SurplusForecast[]
  rescueDispatches RescueDispatch[]
  simulationScenarios SimulationScenario[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Listing {
  id                 String        @id @default(cuid())
  foodId             String
  food               Food          @relation(fields: [foodId], references: [id])
  originalPriceCents Int
  priceCents         Int
  discountRate       Int           // Percentage, from 0 to 100
  autoPricingEnabled Boolean       @default(false)
  lastAutoPriceReviewAt DateTime?
  lastAutoPriceReason String?
  quantityTotal      Int
  quantityRemaining  Int
  pickupWindowStart  DateTime
  pickupWindowEnd    DateTime
  status             ListingStatus @default(ACTIVE)
  diningHallId String
  diningHall   DiningHall @relation(fields: [diningHallId], references: [id])
  createdById String?
  createdBy   User?   @relation("CreatedBy", fields: [createdById], references: [id])
  orders    Order[]
  events    ListingEvent[]
  priceChanges PriceChange[]
  mediaAssets MediaAsset[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([diningHallId, status, pickupWindowStart])
}

model Food {
  id           String        @id @default(cuid())
  name         String
  description  String
  allergens    Allergen[]    @default([])
  category     FoodCategory? 
  unitWeightKg Float?
  listings     Listing[]
  listingDrafts ListingDraft[]
}

model ListingDraft {
  id                String            @id @default(cuid())
  diningHallId      String
  diningHall        DiningHall        @relation(fields: [diningHallId], references: [id])
  createdById       String?
  createdBy         User?             @relation("CreatedByDrafts", fields: [createdById], references: [id])
  foodId            String?
  food              Food?             @relation(fields: [foodId], references: [id])
  title             String
  originalPriceCents Int?
  priceCents        Int?
  discountRate      Int?
  quantityTotal     Int?
  pickupWindowStart DateTime?
  pickupWindowEnd   DateTime?
  status            DraftStatus       @default(DRAFT)
  notes             String?
  mediaAssets       MediaAsset[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model ListingEvent {
  id        String   @id @default(cuid())
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id])
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([listingId, createdAt])
}

model PriceChange {
  id               String         @id @default(cuid())
  listingId        String
  listing          Listing        @relation(fields: [listingId], references: [id])
  pricingPolicyId  String?
  pricingPolicy    PricingPolicy? @relation(fields: [pricingPolicyId], references: [id])
  oldPriceCents    Int
  newPriceCents    Int
  reason           String?
  appliedAt        DateTime       @default(now())
  createdAt        DateTime       @default(now())
}

model PricingPolicy {
  id                String        @id @default(cuid())
  diningHallId      String
  diningHall        DiningHall    @relation(fields: [diningHallId], references: [id])
  name              String
  defaultDiscountRate Int          @default(0)
  minDiscountRate   Int           @default(0)
  maxDiscountRate   Int           @default(100)
  autoApply         Boolean       @default(false)
  validFrom         DateTime
  validTo           DateTime?
  notes             String?
  priceChanges      PriceChange[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([diningHallId, validFrom])
}

model ModelVersion {
  id          String          @id @default(cuid())
  name        String          @unique
  modelFamily String
  versionLabel String
  notes       String?
  publishedAt DateTime?
  surplusForecasts SurplusForecast[]
  createdAt   DateTime        @default(now())
}

model DailyProduction {
  id             String       @id @default(cuid())
  diningHallId   String
  diningHall     DiningHall   @relation(fields: [diningHallId], references: [id])
  producedOn     DateTime
  category       FoodCategory?
  preparedMeals  Int          @default(0)
  soldMeals      Int          @default(0)
  leftoverMeals  Int          @default(0)
  preparedKg     Float?
  leftoverKg     Float?
  createdAt      DateTime     @default(now())

  @@unique([diningHallId, producedOn, category])
  @@index([diningHallId, producedOn])
}

model WeatherObservation {
  id             String       @id @default(cuid())
  diningHallId   String
  diningHall     DiningHall   @relation(fields: [diningHallId], references: [id])
  observedAt     DateTime
  temperatureC   Float?
  precipitationMm Float?
  humidityPct    Float?
  condition      String?
  source         String?
  surplusForecasts SurplusForecast[]
  createdAt      DateTime     @default(now())

  @@index([diningHallId, observedAt])
}

model CampaignEvent {
  id              String          @id @default(cuid())
  diningHallId    String?
  diningHall      DiningHall?     @relation(fields: [diningHallId], references: [id])
  name            String
  startsAt        DateTime
  endsAt          DateTime
  expectedAttendance Int?
  category        String?
  notes           String?
  surplusForecasts SurplusForecast[]
  createdAt       DateTime        @default(now())
}

model SurplusForecast {
  id                 String          @id @default(cuid())
  diningHallId       String
  diningHall         DiningHall      @relation(fields: [diningHallId], references: [id])
  category           FoodCategory?
  forecastDate       DateTime
  predictedSurplusMeals Int?
  predictedSurplusKg Float?
  confidence         Float?
  modelVersionId     String?
  modelVersion       ModelVersion?   @relation(fields: [modelVersionId], references: [id])
  weatherObservationId String?
  weatherObservation WeatherObservation? @relation(fields: [weatherObservationId], references: [id])
  campaignEventId    String?
  campaignEvent      CampaignEvent?  @relation(fields: [campaignEventId], references: [id])
  notes              String?
  createdAt          DateTime        @default(now())

  @@index([diningHallId, forecastDate])
}

model RescueDestination {
  id               String          @id @default(cuid())
  name             String
  type             RescueDestinationType @default(PANTRY)
  address          String?
  capacityKg       Float?
  active           Boolean         @default(true)
  rescueDispatches RescueDispatch[]
  createdAt        DateTime        @default(now())
}

model RescueDispatch {
  id               String          @id @default(cuid())
  diningHallId     String
  diningHall       DiningHall      @relation(fields: [diningHallId], references: [id])
  destinationId    String
  destination      RescueDestination @relation(fields: [destinationId], references: [id])
  category         FoodCategory?
  dispatchedAt     DateTime
  kgRedistributed  Float?
  status           RescueDispatchStatus @default(PLANNED)
  notes            String?
  createdAt        DateTime        @default(now())

  @@index([diningHallId, dispatchedAt])
}

model SimulationScenario {
  id            String       @id @default(cuid())
  diningHallId  String?
  diningHall    DiningHall?  @relation(fields: [diningHallId], references: [id])
  name          String
  scenarioDate  DateTime
  description   String?
  inputs        Json?
  outputs       Json?
  createdAt     DateTime     @default(now())
}

model MediaAsset {
  id            String       @id @default(cuid())
  kind          MediaKind    @default(IMAGE)
  url           String
  filename      String?
  listingId     String?
  listing       Listing?     @relation(fields: [listingId], references: [id])
  listingDraftId String?
  listingDraft  ListingDraft? @relation(fields: [listingDraftId], references: [id])
  createdAt     DateTime     @default(now())
}

model Order {
  id                 String      @id @default(cuid())
  listingId          String
  listing            Listing     @relation(fields: [listingId], references: [id])
  studentId          String
  student            User        @relation(fields: [studentId], references: [id])
  quantity           Int         @default(1)
  originalPriceCents Int
  discountRate       Int
  finalPriceCents    Int
  platformFeeCents   Int         @default(0)
  serviceFeeCents    Int         @default(0)
  pickupCode         String?     @unique
  status             OrderStatus @default(PENDING_PAYMENT)
  reminderOpenSent  Boolean   @default(false)
  reminderCloseSent Boolean   @default(false)
  paymentRef     String      @unique   // simulates WeChat's prepay_id
  paidAt         DateTime?
  refundedAt     DateTime?
  refundAmountCents Int?
  pickupWindowStart  DateTime
  pickupWindowEnd    DateTime
  pickedUpAt         DateTime?
  impactRecords      ImpactRecord[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([studentId, createdAt])
  @@index([listingId, status])
  @@index([pickupWindowEnd, status])
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  password        String
  name            String?
  role            Role          @default(STUDENT)
  diningHallId    String?
  diningHall      DiningHall?   @relation("Supervisors", fields: [diningHallId], references: [id])
  createdListings Listing[]     @relation("CreatedBy")
  createdDrafts   ListingDraft[] @relation("CreatedByDrafts")
  orders          Order[]
  notifications   Notification[]
  sessions        AuthSession[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model EmissionFactor {
  id            String       @id @default(cuid())
  category      FoodCategory
  co2ePerKg     Float?       // kg CO2e avoided per kg of food diverted
  waterLPerKg   Float?       // litres of water saved per kg
  landM2PerKg   Float?       // m² of land saved per kg
  source        String       // citation / methodology reference
  validFrom     DateTime
  impactRecords ImpactRecord[]
  createdAt     DateTime     @default(now())

  @@unique([category, validFrom])
  @@index([category, validFrom])
}

model ImpactRecord {
  id               String          @id @default(cuid())
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  diningHallId     String
  diningHall       DiningHall      @relation(fields: [diningHallId], references: [id])
  occurredAt       DateTime        // = order.pickedUpAt
  category         FoodCategory?
  emissionFactorId String?
  emissionFactor   EmissionFactor? @relation(fields: [emissionFactorId], references: [id])
  methodVersion    String

  mealsRescued        Int           // always measured (picked-up quantity)
  kgDiverted          Float?
  kgDivertedBasis     MetricBasis
  co2AvoidedKg        Float?        // kg CO2e
  co2AvoidedBasis     MetricBasis
  waterSavedL         Float?        // litres
  waterSavedBasis     MetricBasis
  landSavedM2         Float?        // m²
  landSavedBasis      MetricBasis
  studentSavingsCents Int?
  studentSavingsBasis MetricBasis

  assumptions String[] @default([])  // human-readable assumptions used
  notes       Json?                  // per-metric calculation notes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orderId, methodVersion])
  @@index([diningHallId, occurredAt])
}

// ════════════════════════════════════════════════════════════════
// ENUMS 
// ════════════════════════════════════════════════════════════════

enum Allergen {
  GLUTEN
  MILK
  EGGS
  FISH
  SHELLFISH
  TREE_NUTS
  PEANUTS
  WHEAT
  SOY
  SESAME
}

enum Role {
  STUDENT
  SUPERVISOR
}

enum ListingStatus {
  ACTIVE
  SOLD_OUT
  EXPIRED
  WITHDRAWN
}

enum OrderStatus {
  PENDING_PAYMENT
  RESERVED
  PICKED_UP
  CANCELLED
  EXPIRED
}

enum DraftStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum FoodCategory {
  COOKED_MEAT
  COOKED_VEGETARIAN
  FRESH_PRODUCE
  BAKERY_DELI
  DAIRY_BASED
  MIXED_FOOD // generic fallback factor
}

enum MetricBasis {
  MEASURED
  ESTIMATED
  UNAVAILABLE
}

enum MediaKind {
  IMAGE
  AUDIO
  VIDEO
}

enum RescueDestinationType {
  PANTRY
  SHELTER
  STAFF_KITCHEN
  COMPOST
  OTHER
}

enum RescueDispatchStatus {
  PLANNED
  DISPATCHED
  COMPLETED
  CANCELLED
}